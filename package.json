{
  "name": "management-system",
  "version": "1.0.0",
  "private": true,
  "description": "MPM 點名系統",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore",
    "test": "vitest run --exclude tests/firestore.rules.test.js",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/firestore.rules.test.js\""
  },
  "dependencies": {
    "firebase": "^12.16.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-tools": "^15.24.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
